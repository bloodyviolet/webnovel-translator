{
  "manifest_version": 3,
  "name": "Webnovel AI Translator (Personal)",
  "version": "2.1.7",
  "minimum_chrome_version": "120",
  "description": "Local llama.cpp/SYCL and compatible model translation with persistent jobs and per-language story glossaries.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webnovel Translator"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
