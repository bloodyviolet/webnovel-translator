{
  "manifest_version": 3,
  "name": "Webnovel AI Translator (Personal)",
  "version": "1.0.0",
  "description": "Genre-aware AI translation for webnovels (Xianxia, Xuanhuan, Wuxia, etc) with a persistent per-story glossary. Personal use only.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webnovel Translator"
  },
  "options_page": "options.html"
}
